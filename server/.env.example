# Copy to /etc/slipnet-ea/server.env (0600). Never commit the real file.
SLIPNET_MONITOR_PASSWORD=change-me
SLIPNET_VLESS_PUBLIC_HOST=public-vless.example.com
SLIPNET_WORKER_ORIGIN_HOST=origin.example.com
SLIPNET_CF_PRIMARY_ACCOUNT_ID=replace-me
SLIPNET_CF_PRIMARY_SUBDOMAIN=replace-me
SLIPNET_CF_PRIMARY_TOKEN_FILE=/etc/slipnet-ea/cloudflare-primary.token
SLIPNET_CF_PRIMARY_MAP_FILE=/var/lib/slipnet-ea/vless-worker-map.tsv
SLIPNET_CF_PRIMARY_PREFIX=asset
SLIPNET_CF_BACKUP_ACCOUNT_ID=replace-me
SLIPNET_CF_BACKUP_SUBDOMAIN=replace-me
SLIPNET_CF_BACKUP_TOKEN_FILE=/etc/slipnet-ea/cloudflare-backup.token
SLIPNET_CF_BACKUP_MAP_FILE=/var/lib/slipnet-ea/vless-worker-backup-map.tsv
SLIPNET_CF_BACKUP_PREFIX=cdn
SLIPNET_XRAY_BIN=/usr/local/bin/xray
SLIPNET_XRAY_CONFIG=/usr/local/etc/xray/config.json
SLIPNET_XRAY_API=127.0.0.1:10085
SLIPNET_VLESS_INBOUND_TAG=vless-cf-tunnel
SLIPNET_CDN_IP_FILE=/etc/slipnet-ea/vless-cdn-ip.txt
